# Aspecto tipo VS Code (Dark Modern)
theme = Dark Modern
font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true
adjust-cell-height = 15%
background-opacity = 1
macos-titlebar-style = tabs
window-padding-x = 10
window-padding-y = 6
window-padding-color = extend
cursor-style = bar
cursor-color = #0078d4
selection-background = #264f78

# Abrir herdr automáticamente en cada ventana
command = {{RUTA_HERDR}}
