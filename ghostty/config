# Paleta Kanagawa (Wave), a juego con herdr y con el tema de Claude Code
theme = Kanagawa Wave
font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true
adjust-cell-height = 15%
background-opacity = 1
macos-titlebar-style = tabs
window-padding-x = 10
window-padding-y = 6
window-padding-color = extend
cursor-style = bar
cursor-color = #c8c093
selection-background = #2d4f67

# Abrir herdr automáticamente en cada ventana
command = {{RUTA_HERDR}}
